{
  "name": "microblog-app",
  "version": "1.0.0",
  "description": "A modern microblog application built with React, TypeScript, and Vite. Features posts, comments, and author pages using JSONPlaceholder API.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --config vite.pages.config.ts",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tyaginboston/microblog-app.git"
  },
  "homepage": "https://tyaginboston.github.io/microblog-app/",
  "keywords": [
    "react",
    "typescript",
    "microblog",
    "vite",
    "react-router",
    "jsonplaceholder",
    "portfolio"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.1",
    "vite": "^5.4.19"
  }
}
